# Velantrim Titan 9.0 — production environment template
# ======================================================
#
#   cp .env.prod.example .env.prod
#   # fill VELANTRIM_API_KEY, then:
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d
#
# This file contains NO secrets and NO credentials. It must stay that way.
# `.env.prod` is ignored by the `.env.*` rule this change added to .gitignore
# (the bare `.env` rule did NOT cover it) and must never be committed. Verify
# with: git check-ignore -v .env.prod
#
# Everything security-relevant is pinned inside docker-compose.prod.yml, not
# here, so an operator cannot weaken the profile by editing this template
# alone. The variables below are the intended operator knobs.


# ─────────────────────────────────────────────────────────────────────────────
# MANDATORY
# ─────────────────────────────────────────────────────────────────────────────

# Bearer of the X-Api-Key header for every authenticated route.
# Startup FAILS CLOSED if this is empty or unset — docker-compose.prod.yml
# declares it as ${VELANTRIM_API_KEY:?...}, and server.py:85 additionally
# refuses to import without it.
#
# Generate:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# Rotate:    on operator change, suspected disclosure, and on a fixed schedule.
# NEVER commit a real value.
VELANTRIM_API_KEY=


# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL — exposure
# ─────────────────────────────────────────────────────────────────────────────

# Host interface for the single published port. Loopback by default.
# Set to 0.0.0.0 ONLY behind a TLS-terminating reverse proxy.
# VELANTRIM_BIND_ADDR=127.0.0.1

# Host-side port. The container port stays 8000.
# VELANTRIM_PUBLIC_PORT=8000

# Comma-separated allowed browser origins. EMPTY = no origin permitted.
# Leave empty unless a browser client on another origin genuinely needs it.
# CORS_ORIGINS=

# INFO or WARNING for production. DEBUG can log request-shaped detail.
# LOG_LEVEL=INFO


# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL — resource ceilings
# ─────────────────────────────────────────────────────────────────────────────

# VELANTRIM_MEM_LIMIT=2g
# VELANTRIM_CPUS=2.0
# RATE_LIMIT_CAPACITY=60
# RATE_LIMIT_REFILL_PER_SEC=1.0


# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL — image contents
# ─────────────────────────────────────────────────────────────────────────────

# Extras compiled into the image. Default `server` is the minimal set
# server.py imports at startup. Widening this increases attack surface and
# image size; `dev` and `audio` must never be used in production.
# RUNTIME_EXTRAS=server


# ─────────────────────────────────────────────────────────────────────────────
# EXTERNAL PROVIDERS — DISABLED BY DEFAULT, ENABLE DELIBERATELY
# ─────────────────────────────────────────────────────────────────────────────
#
# Every variable in this block ENABLES OUTBOUND NETWORK ACCESS to a third party
# and sends prompt content off-host. None of them is referenced by
# docker-compose.prod.yml, so no provider is configured from the environment.
#
# ⚠️ "No provider configured" is NOT "providers blocked". PR #63 review (P1):
# server.py::_resolve_llm_config_for_request prefers a config built from the
# REQUEST over the environment default, and the LLM/STT/TTS routes are always
# registered. Any client that already holds VELANTRIM_API_KEY can therefore put
#
#     {"llm_provider": "...", "llm_api_key": "..."}
#
# in a request body and reach a remote provider — sending query text and
# retrieved memory off-host — while this profile still reports
# LLM_PROVIDER=none. Setting LLM_PROVIDER=none does not prevent that.
#
# What DOES stop it is the policy boundary, now implemented and pinned by this
# profile (core/policy_kernel.py + core/remote_egress.py):
#
#   VELANTRIM_NETWORK_MODE=deny
#   VELANTRIM_REMOTE_DATA_MODE=never
#
# With deny, every server-side LLM/STT/TTS path fails to obtain a capability
# lease and raises RemoteEgressDeniedError before any HTTP client is built —
# request-supplied llm_provider + llm_api_key included. Both variables are
# validated at startup; an invalid value refuses to boot.
#
# Defence in depth still applies: restrict who holds VELANTRIM_API_KEY, and
# enforce egress at a layer below the application (host firewall, egress proxy,
# NetworkPolicy). See docs/REMOTE_EGRESS_POLICY.ru.md.
#
# ── How to actually configure a provider from the environment ────────────────
#
# ⚠️ Putting a credential in `.env.prod` alone does NOT reach the container.
# docker-compose.prod.yml declares an explicit `environment:` list, and only the
# variables named there are passed in. `--env-file` supplies values for `${...}`
# interpolation, nothing more. `LLM_PROVIDER` IS interpolated, so setting it in
# `.env.prod` works — but `ANTHROPIC_API_KEY` and friends are not referenced at
# all, so they would be silently ignored and the provider would fail to
# authenticate.
#
# To configure one you must ALSO pass the credential into the container, e.g.
# with a small override file that is never committed:
#
#   # docker-compose.provider.yml   (add to .gitignore)
#   services:
#     velantrim:
#       environment:
#         - ANTHROPIC_API_KEY=${ANTHROPIC_API_KEY:?provider key required}
#
#   docker compose -f docker-compose.prod.yml -f docker-compose.provider.yml \
#     --env-file .env.prod up -d
#
# Recognised providers and their credential variables (server.py:150-176):
#
#   anthropic   → ANTHROPIC_API_KEY    (+ optional ANTHROPIC_MODEL)
#   openai      → OPENAI_API_KEY       (+ optional OPENAI_MODEL)
#   deepseek    → DEEPSEEK_API_KEY     (+ optional DEEPSEEK_MODEL)
#   gemini      → GEMINI_API_KEY or GOOGLE_API_KEY (+ optional GEMINI_MODEL)
#   openrouter  → OPENROUTER_API_KEY   (+ optional OPENROUTER_MODEL)
#
# Rotate every provider credential you introduce. Never commit one.
#
# Note also that the answer-integrity checks do NOT cover a provider answer:
# ENABLE_RESPONSE_GUARDIAN and ENABLE_OUTPUT_FAITHFULNESS run inside
# core/pipeline.py, whereas server.py returns `llm_answer` generated afterwards,
# and /chat returns the provider reply directly.


# ─────────────────────────────────────────────────────────────────────────────
# OTHER CREDENTIALLED INTEGRATIONS — ABSENT BY DESIGN
# ─────────────────────────────────────────────────────────────────────────────
#
# Telegram ingestion is pinned off (ENABLE_TELEGRAM_INGEST=0). If ever enabled,
# TELEGRAM_WEBHOOK_SECRET is mandatory: server.py:3534 is fail-closed and
# returns 403 when it is unset, but the route also becomes an unauthenticated
# write path into memory. Treat enabling it as a separate security review.
#   # TELEGRAM_BOT_TOKEN=
#   # TELEGRAM_WEBHOOK_SECRET=
#
# Neo4j / Graphiti (STORAGE_BACKEND=neo4j) needs NEO4J_URI, NEO4J_USER and
# NEO4J_PASSWORD. This profile pins STORAGE_BACKEND=sqlite, so no database
# service and no database port exist. Do not commit these values.
#   # NEO4J_URI=
#   # NEO4J_USER=
#   # NEO4J_PASSWORD=


# ─────────────────────────────────────────────────────────────────────────────
# MUST NOT BE SET IN PRODUCTION
# ─────────────────────────────────────────────────────────────────────────────
#
# VELANTRIM_ALLOW_OPEN=true
#     Disables API-key enforcement entirely (server.py:69). Never set this.
#
# ENABLE_API_DOCS=true
#     Publishes the Swagger/OpenAPI admin surface (server.py:456-458).
#
# SLEEP_WORKER_ENABLED=true
#     Starts the autonomous idle-time cognitive worker. NOTE: the code default
#     is "true" (server.py:60), which is exactly why
#     docker-compose.prod.yml pins it to false.
#
# VELANTRIM_PROFILE=research | cognitive
#     config/profiles/research.env and cognitive.env re-enable the sleep worker
#     and large cognitive stacks at boot.
#
# COMPUTE_PROFILE=standard | heavy
#     Escalates a block of research flags (core/compute_profile.py). The
#     explicit ENABLE_*=0 pins in docker-compose.prod.yml override this, but
#     do not rely on that — leave COMPUTE_PROFILE=lite.
