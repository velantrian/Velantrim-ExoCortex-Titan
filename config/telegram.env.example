# Telegram → L0/L1 (Спринт 2.6)
# Скопируйте в .env или подмешайте в exocortex-dev.env

ENABLE_TELEGRAM_INGEST=1
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# Секрет для POST /telegram/webhook (тот же передаётся в setWebhook)
TELEGRAM_WEBHOOK_SECRET=случайная_строка_32_символа

# Webhook URL (пример):
# https://your-host/telegram/webhook
