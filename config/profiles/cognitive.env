# 🧠 Профиль «Cognitive» — живая память включена (все P0-органы этой сессии)
# Опт-ин: выбери этот профиль, чтобы включить органы. Основной .env не меняется.
VELANTRIM_PROFILE=cognitive
LLM_PROVIDER=none
SLEEP_WORKER_ENABLED=true

# Базовый граф связей
ENABLE_CAUSAL_GRAPH=1

# ── Живая память (P0-органы, построены и протестированы 2026-05-31) ──
ENABLE_GRADUATED_PROMOTION=1      # 🫀 обучение по доказательствам (а не штамп по confidence)
ENABLE_SEMANTIC_DEDUP=1           # 🧬 дедуп → корроборация ПО СМЫСЛУ
ENABLE_CONTRADICTION_RESOLVER=1   # ⚖️ память не «гниёт» (новое вытесняет старое)
ENABLE_DECAY_ORCHESTRATOR=1       # 🌙 умное забывание (внимание, не истина)
ENABLE_SLEEP_CONSOLIDATION=1      # 🌙 ночной цикл, связывающий всё в один ритм
CONSOLIDATION_ON_SLEEP=1
ENABLE_ESSENCE=1                  # 🌿 ответ «по сути» + причинная цепочка + WhyTrace
ENABLE_WORKING_NOTEBOOK=1         # 📓 «думай, как я» (модель мышления пользователя)

# ── Семантика на русском / кросс-язык (откалибровано 2026-05-31) ──
# Многоязычная модель → дедуп сольёт ru↔en (MiniLM-L6 англо-центричен и переслиял RU).
SEMANTIC_DEDUP_MODEL=paraphrase-multilingual-MiniLM-L12-v2
# Порог 0.90 (RU-калибровка: «разные» пары p99=0.685/max=0.872 → 0.90 ловит только
# парафразы; на полном корпусе 13 кластеров, max размер 4 вместо 433/max 42 при 0.78).
SEMANTIC_DEDUP_THRESHOLD=0.90
# Защита от переслияния: компонент крупнее 8 не сливается (разбивается, лог).
SEMANTIC_DEDUP_MAX_CLUSTER=8
