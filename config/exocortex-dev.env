# Профиль разработки ExoCortex (V8.6 Complex)
# Использование (PowerShell):
#   Get-Content config\exocortex-dev.env | ForEach-Object {
#     if ($_ -match '^\s*([^#][^=]+)=(.*)$') { $env:$($matches[1].Trim()) = $matches[2].Trim() }
#   }
# Или скопируйте нужные строки в .env

VELANTRIM_API_KEY=dev-change-me
VELANTRIM_ALLOW_OPEN=true
LLM_PROVIDER=none
SLEEP_WORKER_ENABLED=true

STORAGE_BACKEND=kuzu
KUZU_DB_PATH=./data/exocortex.kuzu
SQLITE_GRAPH_PATH=./data/exocortex_graph.db

ENABLE_CAUSAL_GRAPH=1
ENABLE_EPISODE_DEDUP=1
CONSOLIDATION_ON_SLEEP=1
CONSOLIDATION_MIN_CONFIDENCE=0.75
ENABLE_L45=1
ENABLE_VELUM=1
ENABLE_SALIENCE=1
ENABLE_CONCEPT_EMERGENCE=1
ENABLE_CONCEPT_PROMOTE=0
ENABLE_ETIR=1
ENABLE_IMMUTABLE_CORE=1
ENABLE_L45=1
ENABLE_PREDICTIVE_FUSION=1
ENABLE_DECAY_ORCHESTRATOR=1
ENABLE_REASONING_BANK=1
ENABLE_EVENT_BUS=1
ENABLE_EVENT_BUS_BACKGROUND=1
ENABLE_L6_WELFARE=1
ENABLE_MEMORY_VOLITION=1
ENABLE_INNENWELT=1
ENABLE_MODE_ROUTER=1
ENABLE_UMWELT_STORE=1
ENABLE_UMWELT_AUTO_SEED=1
# Telegram (раскомментируйте token для бота)
ENABLE_TELEGRAM_INGEST=1
ENABLE_DOMAIN_TAGS=1
ENABLE_COGNITIVE_FACT=1
ENABLE_COGNITIVE_STORE=1
ENABLE_COGNITIVE_RUNTIME=1
ENABLE_CROSS_DOMAIN=1
ENABLE_CROSS_DOMAIN_CAUSAL=1

# Titan v7.5 → V8.6 port (май 2026)
ENABLE_OUTPUT_FAITHFULNESS=1
ENABLE_MEMORY_BUDGET=1
ENABLE_CIRCUIT_BREAKER=1
ENABLE_RESPONSE_GUARDIAN=1
ENABLE_ACTR_ACTIVATION=1
MEMORY_BUDGET_FACT_HARD=100000
MEMORY_BUDGET_FACT_GC=85000
MEMORY_BUDGET_FACT_WARN=80000
# ENABLE_CROSS_DOMAIN_LLM_ROUTING=1
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=
