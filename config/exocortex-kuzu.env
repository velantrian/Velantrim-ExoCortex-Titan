# Профиль L3: Kuzu (встроенный граф)
# Скопируйте строки в .env или загрузите перед запуском uvicorn.
# Windows: нужен Microsoft VC++ Redistributable 2015–2022 (x64).
#   https://learn.microsoft.com/cpp/windows/latest-supported-vc-redist

STORAGE_BACKEND=kuzu
KUZU_DB_PATH=./data/exocortex.kuzu

# Остальное — как в exocortex-dev.env (при необходимости)
VELANTRIM_DB_PATH=./data/velantrim_house.db
VELANTRIM_NGRAM_DB=./data/ngram_house.db
ENABLE_CAUSAL_GRAPH=1
ENABLE_VELUM=1
ENABLE_ETIR=1
