# Подключение LLM к серверу Velantrim (скопируйте строки в .env)
# В консоли /console можно также задать ключ в браузере (не сохраняется на диске сервера).

# ── Обязательная политика remote egress ─────────────────────────────────────
# По умолчанию Titan запрещает серверу любые внешние вызовы и передачу данных.
# Для LLM/STT/TTS нужно ЯВНО разрешить и сеть, и тип передаваемых данных:
#
# VELANTRIM_NETWORK_MODE=allow
# VELANTRIM_REMOTE_DATA_MODE=allowed
#
# Допустимые значения:
#   VELANTRIM_NETWORK_MODE=deny|ask|allow
#   VELANTRIM_REMOTE_DATA_MODE=never|redacted|allowed
#
# ask пока fail-closed: интерактивный consent broker ещё не реализован.
# redacted разрешает только вызовы, которые действительно прошли redaction;
# обычный чат/STT/TTS передаёт raw payload и будет заблокирован.
#
# Для полностью local-first режима оставьте defaults:
# VELANTRIM_NETWORK_MODE=deny
# VELANTRIM_REMOTE_DATA_MODE=never

# OpenAI
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=chat-latest
# Другие варианты: gpt-5.5, gpt-5.4

# DeepSeek (POST https://api.deepseek.com/chat/completions — без /v1)
# Модели: deepseek-v4-flash (по умолчанию), deepseek-v4-pro
# LLM_PROVIDER=deepseek
# DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_MODEL=deepseek-v4-flash

# ── Лимиты контекста (core/llm_context_budget.py) ───────────────────────────
# Titan НЕ сокращает текст молча. По умолчанию лимита на сообщение нет
# (действует только окно контекста модели у провайдера; токены Titan не считает).
# Если задать лимит, вопрос и обязательные инструкции не режутся: запрос
# отклоняется понятной ошибкой llm_context_limit; записи памяти и реплики
# истории не передаются только целиком, и это видно в context_report.
# DEEPSEEK_MESSAGE_CHAR_LIMIT=            # пусто = нет лимита (Flash и Pro одинаково)
# LLM_CHAT_HISTORY_MAX_TURNS=20           # off = вся история; применение видно в context_report
# CONSOLE_BLOCK_MEMORY_MAX_ITEMS=40       # off = все заметки блока памяти
# CONSOLE_PREVIOUS_SUMMARY_MAX_CHARS=     # пусто = сводка целиком; иначе сокращение с пометкой
# CONSOLE_HISTORY_TURN_MAX_CHARS=         # пусто = реплика целиком; иначе сокращение с пометкой
# Это не лимит длины ответа модели (max_tokens) — это отдельная настройка.

# Google Gemini
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-2.5-flash

# OpenRouter (много моделей одним ключом)
# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODEL=openai/chat-latest

# Anthropic Claude
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Без LLM (только факты из памяти):
# LLM_PROVIDER=none
