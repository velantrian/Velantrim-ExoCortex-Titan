# Подключение LLM к локальному серверу Velantrim Titan
# ====================================================
#
# КАНОНИЧЕСКИЙ ПУТЬ ДЛЯ ОБЫЧНОГО ПОЛЬЗОВАТЕЛЯ:
#
#   python scripts/configure_llm.py
#
# Скрипт:
# - показывает только direct providers, реально исполняемые server runtime;
# - запрашивает provider API key через скрытый ввод;
# - НЕ печатает секрет;
# - объясняет remote-data boundary;
# - меняет fail-closed egress policy только после точной фразы согласия;
# - сохраняет существующие посторонние .env-настройки;
# - после изменения требует перезапуск Titan.
#
# Проверка состояния без вывода секретов:
#
#   python scripts/configure_llm.py --status

# ── Почему одного API key недостаточно ───────────────────────────────────────
# По умолчанию Titan local-first и запрещает серверу внешний network/data egress:
#
#   VELANTRIM_NETWORK_MODE=deny
#   VELANTRIM_REMOTE_DATA_MODE=never
#
# Connection test отправляет только фиксированный Titan-owned synthetic prompt.
# Для него достаточно network=allow; пользовательские данные он не несёт.
#
# Обычный remote chat передаёт выбранному провайдеру prompt и, когда это нужно
# ответу, выбранный memory/context. Поэтому normal chat дополнительно требует:
#
#   VELANTRIM_REMOTE_DATA_MODE=allowed
#
# `ask` остаётся fail-closed: runtime consent broker специально не добавляется.
# `redacted` не разрешает обычный raw chat.
#
# Не создавайте endpoint, который меняет эти policy из браузера: authority
# остаётся у локального владельца .env / процесса.

# ── Direct server providers ──────────────────────────────────────────────────
# Значения ниже приведены для ручной настройки/аудита. Wizard предпочтительнее.

# OpenAI
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=chat-latest
# Другие варианты из текущего catalog: gpt-5.5, gpt-5.5-2026-04-23

# DeepSeek
# LLM_PROVIDER=deepseek
# DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_MODEL=deepseek-v4-flash
# Другой вариант: deepseek-v4-pro

# Google Gemini
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-3.5-flash

# OpenRouter
# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODEL=openai/chat-latest
# Через OpenRouter доступны также Qwen, Gemini, DeepSeek, Anthropic и другие
# модели из текущего provider catalog.

# Anthropic Claude
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-6
# Другой вариант: claude-opus-4-8

# Без remote LLM (local-first режим):
# LLM_PROVIDER=none
# VELANTRIM_NETWORK_MODE=deny
# VELANTRIM_REMOTE_DATA_MODE=never
