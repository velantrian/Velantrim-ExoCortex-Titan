# Подключение LLM к серверу Velantrim (скопируйте строки в .env)
# В консоли /console можно также задать ключ в браузере (не сохраняется на диске сервера).

# OpenAI
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=chat-latest
# Другие варианты: gpt-5.5, gpt-5.4

# DeepSeek (POST https://api.deepseek.com/chat/completions — без /v1)
# Модели: deepseek-v4-flash (по умолчанию), deepseek-v4-pro
# LLM_PROVIDER=deepseek
# DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_MODEL=deepseek-v4-flash

# Google Gemini
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-2.5-flash

# OpenRouter (много моделей одним ключом)
# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODEL=openai/chat-latest

# Anthropic Claude
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Без LLM (только факты из памяти):
# LLM_PROVIDER=none
