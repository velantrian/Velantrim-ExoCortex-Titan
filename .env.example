# Velantrim Titan 9.0 — конфигурация
# ==========================================
# Скопируй в .env и заполни

# ОБЯЗАТЕЛЬНО (без этого сервер не стартует)
# Сгенерируй: python -c "import secrets; print(secrets.token_urlsafe(32))"
VELANTRIM_API_KEY=

# Пути к базам данных
VELANTRIM_DB_PATH=./data/velantrim_house.db
VELANTRIM_NGRAM_DB=./data/ngram_house.db

# Remote egress — fail-closed по умолчанию.
# Не меняйте эти значения просто ради «чтобы LLM заработал».
# Канонический opt-in: python scripts/configure_llm.py
# Он объяснит, какие данные покидают машину, и изменит policy только после
# явного подтверждения пользователя.
VELANTRIM_NETWORK_MODE=deny
VELANTRIM_REMOTE_DATA_MODE=never

# LLM (для чата в /console — см. config/llm.example.env)
LLM_PROVIDER=none
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Профиль железа (local-first default): lite | standard | heavy
# Явный ENABLE_*=0|1 всегда побеждает профиль. LLM_PROVIDER профилем НЕ трогается.
# COMPUTE_PROFILE=lite
# COMPUTE_PROFILE=standard
# COMPUTE_PROFILE=heavy
# ENABLE_EDGE_SUGGESTER=1
# ENABLE_XAI=1
# WriteProtocolGate обязателен. Legacy-поле оставлено только для диагностики;
# значение 0 не отключает canonical safety boundary.
# ENABLE_WRITE_GATE=1

# Воркер
SLEEP_WORKER_ENABLED=true

# CORS (пусто = отключён)
CORS_ORIGINS=

# Порт
PORT=8000

# ExoCortex-слои (по умолчанию выкл., кроме causal)
# L3 граф: sqlite | kuzu | ladybug (см. docs/KUZU_SETUP.ru.md)
# STORAGE_BACKEND=kuzu
# KUZU_DB_PATH=./data/exocortex.kuzu
# STORAGE_BACKEND=sqlite
# SQLITE_GRAPH_PATH=./data/exocortex_graph.db
# ENABLE_VELUM=1
# ENABLE_SALIENCE=1
# ENABLE_CONCEPT_EMERGENCE=1
# ENABLE_ETIR=1
# ENABLE_IMMUTABLE_CORE=1
# ENABLE_L45=1
# ENABLE_RESPONSE_AUDIT=1
# ENABLE_FOCUS_ENGINE=1
# ENABLE_PREDICTIVE_FUSION=1
# ENABLE_DECAY_ORCHESTRATOR=1
# ENABLE_REASONING_BANK=1
# ENABLE_CAUSAL_GRAPH=1
# ENABLE_EVENT_BUS=1
# ENABLE_EVENT_BUS_BACKGROUND=1
# ENABLE_L6_WELFARE=1
# ENABLE_MEMORY_VOLITION=1

# Titan v7.5 → V8.6 (опционально, по умолчанию выкл.)
# ENABLE_OUTPUT_FAITHFULNESS=1
# ENABLE_MEMORY_BUDGET=1
# ENABLE_CIRCUIT_BREAKER=1
# ENABLE_RESPONSE_GUARDIAN=1
# ENABLE_ACTR_ACTIVATION=1
# MEMORY_BUDGET_FACT_HARD=100000

# Профиль dev (все ExoCortex + L6): см. config/exocortex-dev.env

# Опциональные настройки парсеров
VELANTRIM_MAX_FILE_SIZE_MB=500
VELANTRIM_WHISPER_MODEL=small
VELANTRIM_WHISPER_LANG=auto
VELANTRIM_WHISPER_DEVICE=cpu
VELANTRIM_OCR_LANG=rus+eng
